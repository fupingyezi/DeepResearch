# =============================================================================
# 生产环境变量模板
# 用法：复制到服务器 DEPLOY_PATH/.env.production 后填写真实值。
#   scp .env.production.example user@server:/opt/mini-deepresearch/.env.production
# 本文件只作模板：不含真实密钥，不进镜像层（.dockerignore 已排除）。
#
# 注意：POSTGRES_* / REDIS_PASSWORD / MINIO_ROOT_* 除供应用读取外，
# 还被 docker-compose.prod.yaml 用于创建中间件服务（部署脚本经
# --env-file .env.production 注入），改动时 DATABASE_URL / REDIS_URL /
# MINIO_ACCESS_KEY 必须同步保持一致。
# =============================================================================

# ---------- 对外访问 ----------
# 公开资源（markdown 图片等）的前缀；有域名填域名，否则填服务器公网 IP
PUBLIC_URL=http://<服务器公网IP>:3000
# HTTP（无 HTTPS）部署必须设 true：否则登录 cookie 带 Secure 标志，
# 浏览器不会回传，表现为"登录成功但一直未登录"。上 HTTPS 后删掉此行。
DISABLE_SECURE_COOKIE=true

# ---------- 鉴权与加密（必改）----------
# 生成：openssl rand -base64 48
AUTH_JWT_SECRET=CHANGE_ME
# 登录态有效期（天），默认 7
AUTH_TOKEN_EXPIRY_DAYS=7
# 模型 API Key 的加密密钥，生成：openssl rand -base64 32
# 一旦设置不可更改，否则已保存的模型密钥将无法解密
MODEL_KEY_ENC_SECRET=CHANGE_ME

# ---------- 数据库 / 中间件（host 用 compose 服务名，勿写 localhost）----------
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=CHANGE_ME
# 用户名/密码须与上面两行一致
DATABASE_URL=postgresql://deepresearch:CHANGE_ME@postgres:5432/DeepResearch

REDIS_PASSWORD=CHANGE_ME
# 密码须与上一行一致（redis://:密码@redis:6379）
REDIS_URL=redis://:CHANGE_ME@redis:6379

MINIO_ROOT_USER=deepresearch
MINIO_ROOT_PASSWORD=CHANGE_ME
# MINIO_ACCESS_KEY / SECRET 须与 ROOT_USER / PASSWORD 一致
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=deepresearch
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=chat-files

# ---------- LLM / 搜索（按需填写）----------
OPENAI_QWEN_API_KEY=
OPENAI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL_NAME=qwen3-235b-a22b
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# 标题生成用的小模型（可选，缺省复用默认模型）
TITLE_MODEL=
TAVILY_API_KEY=

# ---------- 沙箱与并发 ----------
# 容器内运行只支持 local（app 容器即隔离边界）；docker 后端需访问宿主
# docker socket，standalone 镜像内不可用
DEERFLOW_SANDBOX_BACKEND=local
# local 后端是否放行 bash（true = agent 可在 app 容器内执行命令）
DEERFLOW_ALLOW_HOST_BASH=false
# run 级并发上限（超限对话排队）
DEERFLOW_MAX_CONCURRENT_RUNS=16
# GET /api/sandbox/stats 访问令牌（不设则该接口禁用）
DEERFLOW_SANDBOX_STATS_TOKEN=
