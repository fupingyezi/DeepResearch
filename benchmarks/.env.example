# =============================================================================
# 基准测试环境变量模板
# 用法：cp benchmarks/.env.example benchmarks/.env.local 后填写真实值。
# 加载顺序见 benchmarks/load-env.ts（后者只在前面都没设该变量时才生效）：
#   benchmarks/.env.local  >  根 .env.local  >  根 .env
# 即根 .env 里已有的 DEEPSEEK_* / TAVILY_API_KEY 会被自动继承，无需重复填写。
# =============================================================================

# ---------- LangSmith 追踪（可选，缺失只告警；仅 --upload 与 trace 查看需要）----------
LANGCHAIN_TRACING_V2=true
# 从 https://smith.langchain.com 获取
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=mini-deepresearch-benchmark

# ---------- 被测 Agent 模型 ----------
# 官方模型名（GET /models 只返回这两个）：deepseek-flash | deepseek-v4-pro
BENCHMARK_AGENT_MODEL=deepseek-flash
# 缺省回落到 DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY
BENCHMARK_AGENT_BASE_URL=
BENCHMARK_AGENT_API_KEY=

# ---------- 评分（Judge）模型 ----------
# ⚠️ 与 agent 侧不同，judge 侧**没有** DEEPSEEK_* 回落：apiKey 与 baseUrl 都必须显式给出，
# 否则请求会带着 DeepSeek key 打到 api.openai.com。config.ts 会直接报错退出（不再静默
# 跳过 judge 或静默改用 agent 模型自评）。想显式不评分请用 --no-judge。
BENCHMARK_JUDGE_MODEL=deepseek-v4-pro
BENCHMARK_JUDGE_BASE_URL=https://api.deepseek.com/v1
# 可与 agent 用同一把 key，但必须显式填
BENCHMARK_JUDGE_API_KEY=

# ---------- 运行参数 ----------
BENCHMARK_CONCURRENCY=2
# 单次 agent run / judge 调用的超时（ms），超限记为独立错误类型，不计入「答错」
BENCHMARK_TIMEOUT_MS=300000
BENCHMARK_VERBOSE=false
