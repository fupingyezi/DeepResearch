# =============================================================================
# 基准测试环境变量模板
# 用法：cp benchmarks/.env.example benchmarks/.env.local 后填写真实值。
# 加载逻辑见 benchmarks/load-env.ts（从仓库根与 benchmarks/ 两处查找）。
# =============================================================================

# ---------- LangSmith 追踪（必填，缺失时 config.ts 直接报错退出）----------
LANGCHAIN_TRACING_V2=true
# 从 https://smith.langchain.com 获取
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=mini-deepresearch-benchmark

# ---------- 被测 Agent 模型 ----------
BENCHMARK_AGENT_MODEL=deepseek-chat
# 缺省回落到 DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY
BENCHMARK_AGENT_BASE_URL=
BENCHMARK_AGENT_API_KEY=

# ---------- 评分（Judge）模型 ----------
BENCHMARK_JUDGE_MODEL=gpt-4o
BENCHMARK_JUDGE_BASE_URL=
BENCHMARK_JUDGE_API_KEY=

# ---------- 运行参数 ----------
BENCHMARK_CONCURRENCY=2
BENCHMARK_TIMEOUT_MS=300000
BENCHMARK_VERBOSE=false
