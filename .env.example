# =============================================================================
# 开发环境变量模板
# 用法：cp .env.example .env 后填写真实值。
# 生产部署见 .env.production.example（服务器 DEPLOY_PATH/.env.production）。
# =============================================================================

# ---------- 模型 API（OpenAI 兼容协议，任选其一或多个）----------
# OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# 阿里千问（DashScope）
OPENAI_QWEN_API_KEY=
OPENAI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Moonshot (Kimi)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# 智谱（GLM 对话预设 / 视觉模型 / embedding / OCR 共用账号）
ZHIPU_API_KEY=
# 可选网关覆盖（默认 https://open.bigmodel.cn/api/paas/v4）
ZHIPU_BASE_URL=
# OCR 模型（默认 glm-ocr）
ZHIPU_OCR_MODEL=
# 单张图片进入多模态消息的字节上限（MB，默认 5）。
# 必须 ≥ 前端 MAX_IMAGE_SIZE_MB，否则会出现「发送成功但模型没看到图」的静默降级。
DEERFLOW_VISION_MAX_IMAGE_MB=5

# 标题生成用的小模型（可选，缺省复用默认模型）
TITLE_MODEL=

# ---------- 记忆向量检索（智谱 embedding-3，OpenAI 兼容）----------
# 缺省全部回落 ZHIPU_API_KEY / 智谱默认端点；无 Key 自动退回关键词检索
DEERFLOW_EMBEDDING_BASE_URL=
DEERFLOW_EMBEDDING_API_KEY=
DEERFLOW_EMBEDDING_MODEL=embedding-3
# 256..2048；变更后存量向量视为失效并自动重嵌（100 条 facts ≈ 2 次请求）
DEERFLOW_EMBEDDING_DIMENSIONS=1024

# ---------- 记忆检索精排（智谱 rerank API）----------
# '0' 显式关闭（检索保持 RRF 融合序）；缺省开启，无 Key / API 失败自动回落 RRF 序
DEERFLOW_RERANK_ENABLED=
DEERFLOW_RERANK_API_KEY=
DEERFLOW_RERANK_MODEL=rerank
DEERFLOW_RERANK_BASE_URL=

# ---------- 数据库 ----------
DATABASE_URL=postgresql://yezi:fupingyezi123@localhost:5432/DeepResearch

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- 文件存储（MinIO）----------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=yezi
MINIO_SECRET_KEY=fupingyezi123
MINIO_BUCKET=chat-files

# ---------- 搜索 ----------
TAVILY_API_KEY=

# ---------- 鉴权与加密 ----------
# 生成：openssl rand -base64 48
AUTH_JWT_SECRET=please_change_this_to_a_long_random_secret
# access token 有效期（分钟），默认 15；失效后由 refresh token 服务端透明续期
AUTH_ACCESS_TOKEN_EXPIRES_MINUTES=15
# refresh token 有效期（天），默认 7；每次刷新滑动续期
AUTH_TOKEN_EXPIRY_DAYS=7
# 纯 HTTP 部署（无 HTTPS，如 http://IP:端口）必须 '1'：去掉 cookie 的 Secure 标志，
# 否则浏览器拒收、登录不生效。上 HTTPS 后删除；dev 的 localhost 不需要。
# DISABLE_SECURE_COOKIE=1
# 模型 API Key 的加密密钥，生成：openssl rand -base64 32
# 一旦设置不可更改，否则已保存的模型密钥将无法解密
MODEL_KEY_ENC_SECRET=
# 体验账号（可选）：两者都非空时登录页显示"一键体验"入口
AUTH_DEMO_EMAIL=
AUTH_DEMO_PASSWORD=
# 注册开关（默认开）：'0' 显式关闭，登录页隐藏注册入口
REGISTRATION_ENABLED=1
# 限流开关（默认开）：'0' 显式关闭（Redis 固定窗口 + 进程内降级）
DEERFLOW_RATE_LIMIT_ENABLED=1

# ---------- SMTP 发信（Phase 2 邮箱验证 / 忘记密码；不配则相关功能降级）----------
SMTP_HOST=
# 587=STARTTLS（多数服务商）、465=隐式 TLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 是否隐式 TLS（465 端口为 true；587 一般 false 走 STARTTLS）
SMTP_SECURE=false
# 发件人地址（须与 SMTP_USER 同域或已获授权，否则会被拒发）
SMTP_FROM=
# 验证邮件里链接的 app 域（如 https://app.example.com；缺省回落 CORS 白名单第一项）
APP_BASE_URL=

# ---------- OAuth 第三方登录（Phase 3；每个平台 client_id+client_secret 双配齐才启用，未配置的按钮自动隐藏）----------
# GitHub：https://github.com/settings/developers → OAuth Apps
#   回调 URI（Authorization callback URL）：{APP_BASE_URL}/api/auth/oauth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Google：https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client IDs（Web 应用）
#   回调 URI：{APP_BASE_URL}/api/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# QQ 互联：https://connect.qq.com → 应用管理
#   回调 URI：{APP_BASE_URL}/api/auth/oauth/qq/callback
OAUTH_QQ_CLIENT_ID=
OAUTH_QQ_CLIENT_SECRET=
# OAuth 回调的绝对基址（redirect_uri 与其拼接）。同源部署可留空（回落 APP_BASE_URL
# → CORS 白名单第一项 → 请求 origin）；**跨域部署必须配**，且 provider 端注册的
# 回调地址须与此基址 + /api/auth/oauth/<provider>/callback 完全一致
OAUTH_BASE_URL=

# ---------- 跨域（前后端分离部署时启用）----------
# 允许跨域调用的前端 origin 精确白名单（逗号分隔，禁通配；空 = 仅同源）。
# 生产示例：https://app.example.com
CORS_ALLOWED_ORIGINS=
# 前端页面注入的 API 基址（window.__API_BASE__）。空 = 同源 /api。
# 前后端分离部署示例：https://api.example.com
API_BASE_URL=

# ---------- 沙箱后端（可选，默认 local）----------
# local（宿主直连）| docker（每线程加固容器）
DEERFLOW_SANDBOX_BACKEND=local
# local 后端是否放行 host bash（docker 后端内核级隔离，不受此门控）
DEERFLOW_ALLOW_HOST_BASH=false
# run 级并发上限（超限对话先回传 queued 状态帧）
DEERFLOW_MAX_CONCURRENT_RUNS=16
# 优雅停机排水窗口（ms，默认 30000）：SIGTERM 后等运行中 run 收尾，超时取消
DEERFLOW_GRACEFUL_DRAIN_MS=30000
# 必须置 1：关掉 Next 自带的 SIGTERM 清理（server.close → exit(0)），把信号
# 交给 instrumentation 的排水序列——否则进程在排水完成前就被 Next 直接退出
NEXT_MANUAL_SIG_HANDLE=1
# 本进程实例标识（多进程部署下 run 的 owner 路由键；缺省 hostname:pid）
DEERFLOW_INSTANCE_ID=
# run owner 登记的 Redis TTL（ms，默认 2h）：owner 进程崩溃后悬挂登记自行过期
DEERFLOW_RUN_OWNER_TTL_MS=7200000
# GET /api/sandbox/stats 访问令牌（未设则接口返回 401，拒绝访问）
DEERFLOW_SANDBOX_STATS_TOKEN=

# ---------- Docker 沙箱后端（DEERFLOW_SANDBOX_BACKEND=docker 时生效）----------
DEERFLOW_DOCKER_IMAGE=python:3.12-slim-bookworm
DEERFLOW_DOCKER_NAME_PREFIX=deerflow-sandbox
DEERFLOW_DOCKER_MEMORY=2g
# 缺省与 MEMORY 相同（禁用 swap）
DEERFLOW_DOCKER_MEMORY_SWAP=
DEERFLOW_DOCKER_CPUS=1.5
DEERFLOW_DOCKER_PIDS_LIMIT=256
# bridge（联网，研究需联网）| none（完全断网）
DEERFLOW_DOCKER_NETWORK=bridge
# 容器内执行命令超时（ms）
DEERFLOW_DOCKER_COMMAND_TIMEOUT_MS=600000
# 空闲回收阈值（ms）与扫描周期（ms）
DEERFLOW_DOCKER_IDLE_TIMEOUT_MS=1800000
DEERFLOW_DOCKER_IDLE_REAP_INTERVAL_MS=60000
# 容器内运行用户（非 root 降权）
DEERFLOW_DOCKER_USER=1000:1000
# docker CLI 可执行文件
DEERFLOW_DOCKER_BIN=docker
# 容器级并发上限（活跃容器数）
DEERFLOW_DOCKER_MAX_LIVE_CONTAINERS=32
# 跨进程协调锁 TTL（ms）
DEERFLOW_DOCKER_ACQUIRE_LOCK_TTL_MS=30000
DEERFLOW_DOCKER_REAP_LOCK_TTL_MS=30000
# 命令失败重试次数
DEERFLOW_DOCKER_COMMAND_MAX_RETRIES=1
# 只读根文件系统 + tmpfs 大小
DEERFLOW_DOCKER_READONLY_ROOTFS=false
DEERFLOW_DOCKER_TMPFS_SIZE=64m

# ---------- Remote SSH 沙箱后端（DEERFLOW_SANDBOX_BACKEND=remote 时生效）----------
# 命令与文件 IO 都在远程主机执行，远程主机即隔离边界（bash 不受 host-bash 门控）。
# 与 docker 后端不同：并发上限按进程独立计（不做跨进程协调）。
# 必需项：DEERFLOW_REMOTE_HOST + 私钥（下列二选一）；缺失时后端构造即报错。
DEERFLOW_REMOTE_HOST=
DEERFLOW_REMOTE_PORT=22
DEERFLOW_REMOTE_USER=root
# 私钥内容（PEM，支持 \n 转义）或私钥文件路径，二者取其一（内容优先）
DEERFLOW_REMOTE_PRIVATE_KEY=
DEERFLOW_REMOTE_PRIVATE_KEY_PATH=
DEERFLOW_REMOTE_PASSPHRASE=
# 远程工作根目录（thread 目录布局与本地同构）
DEERFLOW_REMOTE_BASE_DIR=/tmp/deerflow-sandbox
# 进程内活跃连接上限
DEERFLOW_REMOTE_MAX_CONCURRENT=8
# 连接空闲回收阈值（ms）与单命令超时（ms）
DEERFLOW_REMOTE_IDLE_TIMEOUT_MS=1800000
DEERFLOW_REMOTE_COMMAND_TIMEOUT_MS=600000
# SSH keepalive 间隔（ms），防中间设备断开长连接
DEERFLOW_REMOTE_KEEPALIVE_MS=15000
# 单文件写入上限（字节），防 base64 往返内存峰值
DEERFLOW_REMOTE_MAX_WRITE_BYTES=2097152

# ---------- 护栏（规则式，零依赖）----------
# 总开关（默认 true）；仅影响是否扫描告警
DEERFLOW_GUARDRAIL_ENABLED=true
# 硬拦截范围：none（默认，仅告警）/ injection（拦提示注入）/ output（拦敏感输出）/ all
DEERFLOW_GUARDRAIL_BLOCK=none

# ---------- 运行期可调（其它）----------
# 单个 ThreadChannel 的事件 buffer 上限（默认 2000；关键帧永不丢弃）
STREAM_BRIDGE_BUFFER_MAX=2000
# 扩展配置文件路径（默认 {cwd}/extensions_config.json）
DEERFLOW_EXTENSIONS_CONFIG_PATH=
# 沙箱工作区根目录（默认 {cwd}/.sandbox；local 后端用）
DEERFLOW_SANDBOX_DIR=
# 技能目录（默认 {cwd}/skills）
DEERFLOW_SKILLS_DIR=
# skill 工具 action=run 的脚本执行超时（ms，默认 60000；低于 100 按 100 处理）
DEERFLOW_SKILL_SCRIPT_TIMEOUT_MS=

# ---------- 调试日志（默认关闭，排障时按需开）----------
# 打印完整 AI 输出（text + reasoning）
DEERFLOW_DEBUG=
# 仅开 AI 输出日志
DEERFLOW_DEBUG_AI=
